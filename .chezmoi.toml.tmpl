{{- $name := promptStringOnce . "name" "Name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $signingkey := promptStringOnce . "signingkey" "SSH signing public key" -}}
{{- $workMachine := promptBoolOnce . "workMachine" "Is this a work machine?" false -}}
[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
signingkey = {{ $signingkey | quote }}
workMachine = {{ $workMachine }}
