README.md

# Work/private values sourced by ~/.config/zsh/functions.zsh.
# Never track this file; it holds internal hostnames.
.config/zsh/private.zsh

# htop rewrites this on every exit (sort_key, columns, etc.) — too noisy to track.
.config/htop/htoprc

# Agent entry points refer to the canonical skills location.
.copilot/skills
.claude/skills

{{ if .workMachine }}
# The separate work-skills repository owns this directory on work machines.
.agents/skills
.agents/skills/**

# Firecrawl credentials are only used on personal machines.
.config/zsh/env.zsh
{{ end }}
